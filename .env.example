# Copy this file to .env for local development. Never commit real values.
# For the pilot, set DATABASE_URL directly in the VM's protected .env file.
# With Key Vault, set DATABASE_SECRET_NAME instead and leave DATABASE_URL empty.
DATABASE_URL=
DATABASE_SECRET_NAME=
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Set to coi_owner only after the database roles and login membership are bootstrapped.
DATABASE_MIGRATION_ROLE=

# Azure identity uses DefaultAzureCredential: managed identity on the VM and
# Azure CLI credentials during local development. Do not set storage account keys.
AZURE_KEY_VAULT_URL=
ARTIFACT_STORE=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_RAW_CONTAINER=raw-pdfs
AZURE_PARSER_CONTAINER=pdfco-json
AZURE_STORAGE_PREFIX=
AZURE_STORAGE_ENCRYPTION_SCOPE=

# Use PDFCO_API_KEY for the pilot, or PDFCO_API_KEY_SECRET_NAME with Key Vault.
PDFCO_API_KEY=
PDFCO_API_KEY_SECRET_NAME=
PDFCO_BASE_URL=https://api.pdf.co/v1
PDFCO_RESULT_HOSTS=pdf-temp-files.s3.amazonaws.com,pdf-temp-files.s3.us-west-2.amazonaws.com,pdf-temp-files.s3-us-west-2.amazonaws.com
PDFCO_POLL_TIMEOUT_SECONDS=180
PROCESSING_STALE_AFTER_SECONDS=3600
MAX_PDF_BYTES=26214400
MAX_PARSER_JSON_BYTES=10485760
SOURCE_MIN_AGE_SECONDS=60

# Local ingestion and artifact paths
INVOICE_INPUT_DIR=data/artopex/invoices
OA_INPUT_DIR=data/artopex/oas
LOCAL_ARTIFACT_DIR=var/artifacts
INVOICE_ARCHIVE_DIR=
OA_ARCHIVE_DIR=
INVOICE_QUARANTINE_DIR=
OA_QUARANTINE_DIR=

# Ingestion defaults
VENDOR_NAME=Artopex
LOG_LEVEL=INFO
